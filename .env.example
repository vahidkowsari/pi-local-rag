# Voyage API key — read from the environment only. Never written to config.json,
# fingerprints, or logs. Presence of this key does not enable cloud mode.
VOYAGE_API_KEY=

# Optional PI_RAG_ overrides (env > saved config > defaults).
# PI_RAG_EMBEDDING_PROVIDER=local
# PI_RAG_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# PI_RAG_EMBEDDING_DIMENSIONS=384
# PI_RAG_RERANKER_PROVIDER=none
# PI_RAG_RERANKER_MODEL=rerank-2.5-lite
# PI_RAG_CANDIDATE_TOP_K=30
# PI_RAG_MAX_CONTEXT_TOKENS=4096
# PI_RAG_HTTP_TIMEOUT_MS=30000
# PI_RAG_HTTP_MAX_RETRIES=3
# PI_RAG_CLOUD_AUTO_REFRESH=false
